# Copia este fichero a .env y rellena los valores:  cp .env.example .env
# .env está en .gitignore: nunca lo subas al repositorio.

# ── Base de datos ─────────────────────────────────────────────
DB_NAME=comunidad
DB_USER=comunidad
DB_PASS=                # contraseña larga y aleatoria
DB_ROOT_PASS=           # otra distinta

# ── Aplicación ────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false         # true muestra errores en pantalla: solo en desarrollo
APP_URL=http://localhost:8080
SESSION_LIFETIME=3600

# Secreto para firmar los tokens del WebSocket y el canal interno web → WebSocket.
# Genéralo con:  openssl rand -hex 32
APP_SECRET=

# URL del WebSocket tal como la ve el navegador (wss://… si la web va por HTTPS)
WS_PUBLIC_URL=ws://localhost:8090

# ── Notificaciones push (opcional) ────────────────────────────
# Genera las claves con:  docker compose exec web php bin/generate-vapid.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@comunidad.local
