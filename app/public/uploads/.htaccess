# Aquí solo hay imágenes subidas por los usuarios: nunca se ejecuta código.
# (Segunda barrera: el vhost de Apache ya desactiva PHP en esta carpeta.)
php_flag engine off
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht .phps
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'"
</IfModule>
